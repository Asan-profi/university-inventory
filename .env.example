# Serverni ishga tushirish porti
PORT=3000

# Sessiya va cookie shifrlash uchun MAXFIY kalit — production'da uzun, tasodifiy qator bilan almashtiring
# Masalan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_THIS_WITH_A_LONG_RANDOM_SECRET

# Ilova qaysi protokol ostida ishlayapti (https bo'lsa cookie faqat HTTPS orqali yuboriladi)
NODE_ENV=production
TRUST_PROXY=1

# Bosh administrator uchun keyinchalik ham foydali bo'lishi mumkin bo'lgan izoh maydoni (ixtiyoriy, ishlatilmaydi)
UNIVERSITY_CODE=ITU

# Birinchi ishga tushirishda avtomatik yaratiladigan bosh administrator
# Ilovani birinchi marta ishga tushirgandan so'ng BU PAROLNI albatta o'zgartiring!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_THIS_STRONG_PASSWORD
ADMIN_FULLNAME=Bosh administrator
